            </cms:storylist>
          </ul>
        </div>
      </div>
      <div class="preview-dialog">
      <div class="close-preview">
        ×
      </div>
      <img class="preview-img" style="cursor:zoom-in" src="" />
    </div>
    </div>
  </body>
</html>
<script>
  		$('.preview-dialog').hide()
    $('.content-box img').on('click', function(event) {
      event.preventDefault();
      console.log($(this))
    	$('.preview-img').attr('src', $(this)[0].currentSrc)
      $('.preview-dialog').show()
    });
$('.preview-img').on('click', function(event) {
    const img = $(this)[0]
    const cursor = img.style.cursor
    if(cursor === 'zoom-in') {
      img.style.cursor='zoom-out';
      img.style.width='100%'
      img.style.height='auto'
      img.style.maxHeight='unset'
      $('.preview-dialog')[0].style.overflow='auto'
    } else {
      img.style.cursor='zoom-in';
      img.style.width='unset'
      img.style.height='unset'
      img.style.maxHeight='100%'
      $('.preview-dialog')[0].style.overflow='unset'
    }
    })
  $('.close-preview').on('click', function(event) {
     $('.preview-dialog').hide()
    $('.preview-img').attr('src', '')
    })
</script>
