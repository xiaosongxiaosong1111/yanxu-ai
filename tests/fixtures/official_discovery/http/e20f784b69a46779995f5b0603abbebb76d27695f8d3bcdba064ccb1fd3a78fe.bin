      <!DOCTYPE html>
<html lang="zh_CN">
  <head>
    <meta charset="utf-8" />
    <style>
      .llTemSwiper {
        width: 13.66rem;
        height: 5rem;
        margin: 0 auto;
      }
      .llTemSwiper-cms {
        width: 13.66rem;
      }
      .ll_list {
        position: relative;
      }
      .ll_title {
        position: absolute;
        width: 13.66rem;
        padding: 0 100px 0 16px;
        bottom: 0;
        left: 0;
        font-size: 18px;
        color: #ffffff;
        line-height: 23px;
        height: 62px;
        line-height: 62px;
        background: linear-gradient(
          180deg,
          rgba(0, 0, 0, 0) 0%,
          #00000086 100%
        );
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding-right: 100px;
        box-sizing: border-box;
      }
      .llTemSwiper ol {
        // display: none !important;
      }
      .ll_list_num {
        position: absolute;
        right: 50px;
        bottom: 20px;
        display: none !important;
      }
      .ll_list_num span {
        font-size: 12px;
        color: #ffffff;
      }
      .ll_list_num #current_num {
        font-size: 18px;
        font-weight: bold;
      }
      .llTemSwiper .lb_l {
        left: .3rem;
        background-color: rgba(0, 0, 0, .7);
        position: absolute;
        top: calc(50% - .32rem);
        width: .4rem;
        height: .64rem;
        z-index: 2;
        text-align: center;
        cursor: pointer;
      }
      .llTemSwiper .lb_r {
        right: .3rem;
        background-color: rgba(0, 0, 0, .7);
        position: absolute;
        top: calc(50% - .32rem);
        width: .4rem;
        height: .64rem;
        z-index: 2;
        text-align: center;
        cursor: pointer;
      }
      .llTemSwiper .lb_r img {        
        transform: rotate(180deg);
      }
      .llTemSwiper .lb_r img, .llTemSwiper .lb_l img{
        width: .12rem;
    		height: .2rem;
    	margin-top: .22rem;
      }
      .llTemSwiper .lb_:hoverl {
        background-color: rgba(149, 21, 0, .7);
      }
      .llTemSwiper .lb_r:hover {
        background-color: rgba(149, 21, 0, .7);
      }
      .ll_list {
        overflow: hidden;
        position: relative;
      }
      .ll_list img {
        width: 100%;
        height: 100%;
        transition: transform 1s, filter 1s;
      }
      /*--.ll_list:hover img {
      transform: scale(1.2);
      filter: brightness(0.7);  可选：降低亮度以突出放大效果 
      cursor: pointer;
      } */
      .ll_list:hover::before {
        content: "";
        display: block;
        position: absolute;
        width: 100%;
        height: 100%;
        // background: rgba(0, 0, 0, 0.5); /* 可选：添加半透明遮罩以突出图片 */
        top: 0;
        left: 0;
      }
      .ll_list a {
        display: block;
        width: 100%;
        height: 65rem;
      }
      .home-swiper ol {
        left: 50%;
      }
    </style>
  </head>
  <body>
    <div class="home-swiper">
      <cms:storylist
        class="llTemSwiper-cms" channelId="yz" type="column" columnId="67595349cf1e66a18c75f35e" count="10" pageNo="0"
      >
        <div class="llTemSwiper">
          <ul>
            
              <li
                class="ll_list"
                index="1" id="https://yanzhao.bisu.edu.cn/mixmedia/a/202308/28/WS676b80a8cf1e66a18c75f50a.html"
              >
                <img
                  src="https://www.bisu.edu.cn/bucketeducation/677605eae4b02d48d8982728.png"
                />
              </li>
            
              <li
                class="ll_list"
                index="2" id="https://yanzhao.bisu.edu.cn/mixmedia/a/202308/16/WS676b80a8cf1e66a18c75f509.html"
              >
                <img
                  src="https://www.bisu.edu.cn/bucketeducation/67760621e4b02d48d898272a.png"
                />
              </li>
            
          </ul>
          <ol></ol>
          <div>
            <span class="lb_l" onclick="leftClick()"><img src="https://caibian.bisu.edu.cn:443/mixmedia/static/yjszsw/statics/img/swiper-left.png" /></span>
            <span class="lb_r" onclick="rightClick()"><img src="https://caibian.bisu.edu.cn:443/mixmedia/static/yjszsw/statics/img/swiper-right.png" /></span>
          </div>
          <div class="ll_list_num" style="display: none">
            <span id="current_num">1</span>
            <span>/</span>
            <span id="total_num">10</span>
          </div>
        </div>
      </cms:storylist>
    </div>
  </body>
</html>
<script>
  function liclick(ele) {
    window.location = ele.id;
  }
    var llTemSwiper = $(".llTemSwiper");
  var unit = "px"; // 单位
  var focusWidth = "13.33rem"; // 轮播图的宽
  var focusHeight = "650" + unit; // 轮播图的高
  var focusOlLeft = "12" + unit; // 小点距左边框距离
  var focusOlTop = "24" + unit; // 小点距右边框距离
  var rotation_Speed = 3000; // 轮播图自动播放速度 毫秒
  var focusUlSize = 150 * $(".llTemSwiper>ul>li").length + "%";
  // 轮播
  var yidongjl = "13.66rem"; // 移动距离
  var num = 0; // 点击计数
  var flag = true; // 节流阀
  // 自动添加小圆点
  var index = 0; // 下标
  var indexLength = 0;
  var ul = $(".llTemSwiper>ul");
  var imgLi = $(".llTemSwiper>ul>li");
  var lb_l = $(".lb_l");
  var lb_r = $(".lb_r");
  indexLength = imgLi.length
  // 右箭头
  function rightClick() {
    console.log('rrrrr')
    if (num == imgLi.length) {
          num = 0;
        }
        if(num > indexLength) {
          num = 0
        }
    move(ul[0], -num * 13.66 + "rem");
        num++;
  }
  function leftClick() {
    console.log('lllll')
    if (num == 0) {
          num = imgLi.length;
        }
        num--;
    move(ul[0], -num * 13.66 + "rem");
  }

  // $(".llTemSwiper>ul>li").each(function(i, element) {
  //   var li = $("<li></li>");
  //   li.attr("index", index++);
  //   li.css({
  //     "list-style-type": "none",
  //     "float": "left",
  //     "width": 10 + unit,
  //     "height": 10 + unit,
  //     "margin": "0 3" + unit,
  //     "border-radius": 5 + unit,
  //     "background": "#fff",
  //     "cursor": "pointer",
  //     "width": "48px",
  //     "height": "6px",
  //     "background": "rgba(255,255,255,0.6)",
  //     "border-radius": "0px 0px 0px 0px",
  //   });
  //   $(".llTemSwiper>ol").append(li);
  // })
  // $(".llTemSwiper>ol>li")[0].style.background = "#FFFFFF";

  // var llTemSwiper = $(".llTemSwiper");
  // var ul = $(".llTemSwiper>ul");
  // var imgLi = $(".llTemSwiper>ul>li");
  // var element = document.getElementById("total_num");
  // element.textContent = imgLi.length
  // indexLength = imgLi.length
  // var lb_l = $(".lb_l");
  // var lb_r = $(".lb_r");
  // var ol = $(".llTemSwiper>ol");
  // var yuanLi = $(".llTemSwiper>ol>li");

  // // 复制第一个图像
  // $(imgLi[0]).clone().appendTo($(ul[0]));

  // 样式部分
  $("li").css("list-style-type", "none");
  $(".llTemSwiper").css({
    position: "relative",
    width: "13.66rem",
    height: "5rem",
    overflow: "hidden",
    "box-sizing": "border-box",
  });
  $(".llTemSwiper>ul").css({
    position: "absolute",
    left: 0,
    width: focusUlSize,
    cursor: "pointer",
    overflow: "hidden",
  });

  $(".llTemSwiper>ul>li").css({
    float: "left",
  });
  $(".llTemSwiper>ul>li>img").css({
    width: "13.66rem",
    height: "5rem",
  });
  $(".llTemSwiper>ol").css({
    position: "absolute",
    right: focusOlLeft,
    bottom: focusOlTop,
  });

  function lj() {
    yuanLi.css({
      background: "rgba(255,255,255,0.6)",
    });
    var p = num > imgLi.length - 1 ? 0 : num;
    yuanLi[p].style.backgroundColor = "#ffffff";
  }
  var timer = setInterval(function () {   
     lb_r.click();
  }, rotation_Speed);
  // 轮播
    llTemSwiper.mouseenter(function() {
      clearInterval(timer);
    })

    llTemSwiper.mouseleave(function() {
      timer = setInterval(function() {
        lb_r.click();
      }, 3000);
    });

  // 动画
  function move(obj, target, callback) {
    $(obj).css("left", target);
  }
  function addNum(numShow) {
    let seNum = numShow;
    var element = document.getElementById("current_num");
    element.textContent = seNum;
  }
</script>


