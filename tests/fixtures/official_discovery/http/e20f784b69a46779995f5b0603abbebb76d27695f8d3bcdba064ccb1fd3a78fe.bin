       <!-- 小研推荐 -->
      <!DOCTYPE html>
<html lang="zh_CN">
  <head>
    <meta charset="utf-8" />
  </head>
  <body>
    <div class="yan">
      <div class="yan-box w1366">
        <div class="title">
          <img src="https://caibian.bisu.edu.cn:443/mixmedia/static/yjszsw/statics/img/icon3.png" />
          <p>小研推荐</p>
        </div>
        <div class="yan-list">
          <div class="yan-item yan1 type1">
            <div class="name">招生简章</div>
            <cms:storylist
              class="zsjz-list" channelId="yz" type="column" columnId="675953f0cf1e66a18c75f370" count="4" pageNo="0"
            >
              <ul>
                
                  <li
                    onclick="showStory(this)" data-id="WS67b7d600cf1e6138de7c6ab7"
                  >
                    <div></div>
                    <a class="dh">
                      <p>北京第二外国语学院2025年攻读硕士学位研究生招生简章</p>
                    </a>
                  </li>
                
                  <li
                    onclick="showStory(this)" data-id="WS676b8100cf1e66a18c75f5ff"
                  >
