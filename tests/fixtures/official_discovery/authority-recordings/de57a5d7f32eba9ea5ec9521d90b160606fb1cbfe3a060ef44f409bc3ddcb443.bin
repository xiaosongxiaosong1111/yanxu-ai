<script type="text/html" id="htmlu3">
    <div id="appu3" class="jdjs_app searchbox">
        <ul>
          <li>
            <input type="text" name="title" class="qwss" placeholder="站内搜索" value="" onkeyup="keyUpFunu3(event)">
