            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
        })

        var ztjjSwiper = new Swiper('.ztjj-img', {
            loop: true,
            autoplay: true,
            spaceBetween: 30,
            slidesPerView: '5',
            loopedSlides: 5,
        })

        $('#ads_close').on('click', function () {
            $('.tdgg_ads').fadeOut(300);
        })

        $(".swiper-pagination-bullet").hover(function () {
            $(this).click(); //鼠标划上去之后，自动触发点击事件来模仿鼠标划上去的事件
        }, function () {
            flashSwiper.autoplay.start(); //鼠标移出之后，自动轮播开启
        })


        var szywSwiper = new Swiper('.szywContainer', {
            loop: true,
            autoplay: {
                disableOnInteraction: false,
                delay: 5000,
                stopOnLastSlide: false,
            }
        })

        var mySwiper = new Swiper('.zjhd', {
            // direction: 'vertical',
            loop: true,
            autoplay: {
                disableOnInteraction: false,
                delay: 4000,
                stopOnLastSlide: false,
                pauseOnMouseEnter: true, // 鼠标置于swiper时暂停自动切换，鼠标离开时恢复自动切换。
            },
        })


        // 通知公告 政策法规
        $('.tzgg_zcfg label').hover(function () {
            $(this).parent().find('label').addClass('uhover')
            $(this).removeClass()
            if ($(this).index() == 0) {
                $('.tzgg').css('display', 'block')
                $('.zcfg').css('display', 'none')
                $(this)
                    .parent()
                    .next()
                    .attr(
                        'href',
                        '/html/website/outsite/xinwenzhongxin/tongzhigonggao/index.html'
                    )
            } else {
                $('.tzgg').css('display', 'none')
                $('.zcfg').css('display', 'block')
                $(this)
                    .parent()
                    .next()
                    .attr(
                        'href',
                        '/html/website/outsite/xinwenzhongxin/zhengcefagui/index.html'
                    )
            }
        })

        // 智库建设 理论探索
        $('.zkjs_llts label').hover(function () {
            $(this).parent().find('label').addClass('uhover')
            $(this).removeClass()
            if ($(this).index() == 1) {
                $('.llts').css('display', 'block')
                $('.zkjs').css('display', 'none')
                $(this)
                    .parent()
                    .next()
                    .attr(
                        'href',
                        '/html/website/outsite/xinwenzhongxin/liluntansuo/index.html'
                    )
            } else {
                $('.llts').css('display', 'none')
                $('.zkjs').css('display', 'block')
                $(this)
                    .parent()
                    .next()
                    .attr(
                        'href',
                        '/html/website/outsite/xinwenzhongxin/zhikujianshe/index.html'
                    )
            }
        })

        //	初始化选中第一个友情链接栏目
        $("#yqlj_links label").first().attr('class', '');

        // 友情链接
        $('.yqlj_links label').hover(function () {
            $(this).parent().find('label').addClass('uhover')
            $(this).removeClass()
            if ($(this).index() == 2) {
                $('.yqlj3').css('display', 'block');
                $('.yqlj1,.yqlj2').css('display', 'none');
            } else if ($(this).index() == 1) {
                $('.yqlj2').css('display', 'block');
                $('.yqlj1,.yqlj3').css('display', 'none');
            } else {
                $('.yqlj1').css('display', 'block');
                $('.yqlj3,.yqlj2').css('display', 'none');
            }
        })

        //	弹窗轮播动画
        var mySwiper1 = new Swiper('.swiper', {
            loop: true, // 循环模式选项
            autoplay: {
                delay: 5000,
                stopOnLastSlide: false,
                disableOnInteraction: true,
                preventClicksPropagation: false,
            },
            // 如果需要前进后退按钮
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },

        })

        $(".popup .close").click(function () {
            $(".popup").hide();
        });



    })

    // ========== 图片预览功能 ==========
    var previewScale = 1;
    var dragState = { dragging: false, startX: 0, startY: 0, translateX: 0, translateY: 0, lastTx: 0, lastTy: 0 };

    function openImgPreview(src) {
        previewScale = 1;
        dragState = { dragging: false, startX: 0, startY: 0, translateX: 0, translateY: 0, lastTx: 0, lastTy: 0 };
        var img = document.getElementById('previewImg');
        img.src = src;
        img.style.transform = 'scale(1) translate(0px, 0px)';
        document.getElementById('imgPreviewOverlay').classList.add('active');
    }

    function closeImgPreview(e) {
        if (e && e.target && (e.target.tagName === 'IMG' || e.target.classList.contains('img-preview-toolbar') || e.target.tagName === 'BUTTON')) return;
        document.getElementById('imgPreviewOverlay').classList.remove('active');
    }

    function zoomImg(delta) {
        if (delta === 0) {
            previewScale = 1;
            dragState.translateX = 0;
            dragState.translateY = 0;
            dragState.lastTx = 0;
            dragState.lastTy = 0;
        } else {
            previewScale = Math.max(0.2, Math.min(5, previewScale + delta));
        }
        document.getElementById('previewImg').style.transform =
            'scale(' + previewScale + ') translate(' + dragState.translateX + 'px,' + dragState.translateY + 'px)';
    }

    function downloadImg() {
        var src = document.getElementById('previewImg').src;
        var a = document.createElement('a');
        a.href = src;
        a.download = src.split('/').pop();
        a.click();
    }

    function startDrag(e) {
        if (previewScale <= 1) return;
        e.preventDefault();
        dragState.dragging = true;
        dragState.startX = e.clientX - dragState.lastTx;
        dragState.startY = e.clientY - dragState.lastTy;
        document.getElementById('previewImg').style.cursor = 'grabbing';

        document.onmousemove = function (ev) {
            if (!dragState.dragging) return;
            dragState.translateX = ev.clientX - dragState.startX;
            dragState.translateY = ev.clientY - dragState.startY;
            dragState.lastTx = dragState.translateX;
            dragState.lastTy = dragState.translateY;
            document.getElementById('previewImg').style.transform =
                'scale(' + previewScale + ') translate(' + dragState.translateX + 'px,' + dragState.translateY + 'px)';
        };
        document.onmouseup = function () {
            dragState.dragging = false;
            document.getElementById('previewImg').style.cursor = 'grab';
            document.onmousemove = null;
            document.onmouseup = null;
        };
    }





</script>