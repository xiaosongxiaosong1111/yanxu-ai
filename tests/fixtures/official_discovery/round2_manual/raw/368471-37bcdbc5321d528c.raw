		var s = document.getElementsByTagName("script")[0];
		s.parentNode.insertBefore(um, s);
	})();
</script>	</div>
</body>

</html>
<script src="/template/1/yjssite/js/jquery-1.12.4.js"></script>
<script src="/template/1/yjssite/js/swiper-bundle.min.js"></script>
<script>
	// $("#btnquery").click(function() {
	//     if ($("#content_title").val() == '') {
	//         alert('请输入关键字查询');
	//         return;
	//     }
	//     $("#searchForm").submit();
	// })


	var mySwiper = new Swiper('.swiper-ads', {
		direction: 'vertical',
		loop: true,
		autoplay: {
			disableOnInteraction: false,
			delay: 2000,
			stopOnLastSlide: false,
			pauseOnMouseEnter: true, // 鼠标置于swiper时暂停自动切换，鼠标离开时恢复自动切换。
		},
	})

	//	flash 轮播
	var flashSwiper = new Swiper('.flash1', {
		loop: true,
		autoplay: {
			disableOnInteraction: false,
			delay: 3000,
			stopOnLastSlide: false,
		},
		pagination: {
			el: '.swiper-pagination',
			clickable: true,
			renderBullet: function (index, className) {
				return '<span class="' + className + '">' + (index + 1) + '</span>'
			},
		},
	})

	$(".swiper-pagination-bullet").hover(function () {
		$(this).click(); //鼠标划上去之后，自动触发点击事件来模仿鼠标划上去的事件
	}, function () {
		flashSwiper.autoplay.start(); //鼠标移出之后，自动轮播开启
	})

	var swiper = new Swiper(".jctj-swiper", {
		slidesPerView: 4,
		spaceBetween: 30,
		autoplay: {
			       disableOnInteraction: false,
			       delay: 2000,
			       stopOnLastSlide: false,
			       pauseOnMouseEnter: true, // 鼠标置于swiper时暂停自动切换，鼠标离开时恢复自动切换。
                },
		
		navigation: {
         nextEl: ".swiper-button-next",
         prevEl: ".swiper-button-prev",
      },
	});


	var searchApp = new Vue({
		el: "#app",
		data: {
			keyword: '',
			select: '1',
			selecttype: '1',
			options: [{
				text: "标题",
				value: "1"
			},
			{
				text: "作者",
				value: "2"
			},
			{
				text: "内容",
				value: "3"
			}
			],
		},
		methods: {
			handleSelect() {
				this.selecttype = this.select;
			},
			btnQuery() {
				if (this.keyword == '') {
					this.$message({
						message: '请输入关键字查询',
						type: 'warning'
					});
					return;
				}
				$("#searchForm").submit();
			}
		}
	})
</script>