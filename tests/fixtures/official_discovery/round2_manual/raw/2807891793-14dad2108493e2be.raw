   <td width="94" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px">125604</span></p></td> 
