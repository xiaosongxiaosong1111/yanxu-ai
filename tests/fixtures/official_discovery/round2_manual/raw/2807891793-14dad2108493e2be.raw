   <td width="454" valign="center" colspan="4" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px"><span style="font-family:仿宋">合计</span></span></p></td> 
   <td width="123" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px">26</span><span style="font-family: 仿宋;font-size: 19px"><span style="font-family:Times New Roman">5</span></span></p></td> 
