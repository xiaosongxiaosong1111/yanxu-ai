  <tr style="height:38px"> 
   <td width="132" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px"><span style="font-family:仿宋">工商管理学院</span></span></p></td> 
   <td width="133" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px"><span style="font-family:仿宋">工商管理</span></span><span style="font-family: 仿宋;font-size: 19px">硕士</span></p></td> 
   <td width="94" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px">1251</span></p></td> 
   <td width="95" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px"><span style="font-family:仿宋">全日制</span></span></p></td> 
   <td width="123" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px">60</span></p></td> 
  </tr> 
  <tr style="height:38px"> 
   <td width="132" valign="center" rowspan="2" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px"><span style="font-family:仿宋">商务信息学院</span></span></p></td> 
   <td width="133" valign="center" rowspan="2" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px"><span style="font-family:仿宋">工程管理</span></span><span style="font-family: 仿宋;font-size: 19px">硕士</span></p></td> 
   <td width="94" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px">125601</span></p></td> 
   <td width="95" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px"><span style="font-family:仿宋">全日制</span></span></p></td> 
   <td width="123" valign="center" style="padding: 0px 7px; border-width: 1px; border-left-color: windowtext; border-right-color: windowtext; border-style: solid; border-top-color: initial; border-bottom-color: windowtext;"><p style=";text-align:center"><span style="font-family: 'Times New Roman';font-size: 19px">20</span></p></td> 
  </tr> 
