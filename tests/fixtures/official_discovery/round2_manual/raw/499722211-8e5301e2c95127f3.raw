    <link rel="stylesheet" href="css/swiper.css">
    <script type="text/javascript" src="js/swiper.min.js"></script>
    <script type="text/javascript" src="js/swiper.progress.min.js"></script>
    <script>
        $(document).ready(function() {

            // 宁师故事
            $('.story-swp1 .swiper-slide').css('width', parseInt($('.story-swp1').innerWidth() * 0.66) + 'px');
            var slideWidth = $('.story-swp1 .swiper-slide').innerWidth();
            var storySwp1 = new Swiper('.story-swp1', {
                speed: 1000,
                slidesPerView: 'auto',
                centeredSlides: true,
                loop: true,
                loopedSlides: 5,
                // autoplay: 3000,
                // autoplayDisableOnInteraction: false,
                progress: true,
                visibilityFullFit: true,
                onlyExternal: true,
                onProgressChange: function(swiper) {
                    for (i = 0; i < swiper.slides.length; i++) {
                        var slide = swiper.slides[i]
                        var slideProgress = slide.progress;
                        modify = 1;
                        if (Math.abs(slideProgress) > 1) {
                            modify = (Math.abs(slideProgress) - 1) * 0.3 + 1;
                        }
                        translate = slideProgress * modify * slideWidth * 0.39 + 'px';
                        scale = 1 - Math.abs(slideProgress) / 5;
                        zIndex = 999 - Math.abs(Math.round(10 * slideProgress));
                        $(slide).css('transform', 'translateX(' + translate + ') scale(' + scale + ')');
                        $(slide).css('zIndex', zIndex);
                        $(slide).css('opacity', 1);
                        if (Math.abs(slideProgress) >= 2) {
                            $(slide).css('opacity', 0);
                        }
                    }
                },
                onSetWrapperTransition: function(swiper, speed) {
                    for (var i = 0; i < swiper.slides.length; i++) {
                        swiper.setTransition(swiper.slides[i], speed);
                    }
                },
            })
            var storySwp2 = new Swiper('.story-swp2', {
                speed: 1000,
                slidesPerView: 1,
                loop: true,
                loopedSlides: 5,
                autoplay: 3000,
                autoplayDisableOnInteraction: false,
                onSlideChangeStart: function(swiper) {
                    storySwp1.swipeTo(storySwp2.activeLoopIndex, 1000, false);
                }
            })
            $('.story-swp1 .swiper-prev').on('click', function(event) {
                event.preventDefault();
                storySwp1.swipePrev()
                storySwp2.swipePrev()
            });
            $('.story-swp1 .swiper-next').on('click', function(event) {
                event.preventDefault()
                storySwp1.swipeNext()
                storySwp2.swipeNext()
            });

        });
    </script>
</body>

</html>
