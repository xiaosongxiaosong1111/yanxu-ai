            // 通知公告
            $('.notice-slk1 .slider').slick({
                speed: 1000,
                dots: false,
                arrows: true,
                appendArrows: '.notice-slk1',
                slidesToShow: 3,
                responsive: [{
                    breakpoint: 768,
